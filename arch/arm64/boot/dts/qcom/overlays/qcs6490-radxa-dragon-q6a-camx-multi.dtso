/dts-v1/;
/plugin/;

#include "qcs6490-radxa-dragon-q6a-camx-common.dtsi"

/ {
	metadata {
		title = "Enable CAM1 + CAM2 on Qualcomm CAMX hardware ISP";
		compatible = "radxa,dragon-q6a";
		category = "camera";
		exclusive = "cci0", "cci1", "camss", "camx-isp", "cci0_i2c0", "cci1_i2c0", "cci1_i2c1";
		description = "Enable CAM1 (slot 12, CSIPHY0, CCI0) and CAM2 (two-lane, slot 8, CSIPHY2, CCI1) together on the Qualcomm CAMX hardware ISP. CAM2 is clocked by its module-local 24 MHz oscillator, the default for CAM2 camera modules. Self-contained: this single overlay carries the shared CAMX infrastructure and every sensor node, so do not enable cam0-camx-common or the per-camera CAMX overlays at the same time. The sensor model is selected by the sensor module bins for slot 12 and slot 8.";
	};
};

/* CAM1: CSIPHY0, CCI0 master 0, MCLK0 (GPIO64), reset GPIO20.
 * The sensor module bin selects sensor identification and operating modes. */
&cam_cci0 {
	qcom,cam-sensor12 {
		compatible = "qcom,cam-sensor";
		cell-index = <12>;
		csiphy-sd-index = <0>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&vreg_l6b_1p2>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		rgltr-min-voltage = <1200000>;
		rgltr-max-voltage = <1200000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active &cam_sensor_active_rst0>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend &cam_sensor_suspend_rst0>;
		gpios = <&tlmm 64 0>, <&tlmm 20 0>;
		gpio-reset = <1>;
		gpio-req-tbl-num = <0 1>;
		gpio-req-tbl-flags = <1 0>;
		gpio-req-tbl-label = "CAM_MCLK0", "CAM_RESET0";
		sensor-mode = <0>;
		cci-master = <0>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};

&{/} {
	/* CAM2 modules carry their own 24 MHz oscillator and take no MCLK from the
	 * SoC, so this is a fixed clock describing the module INCK. 24 MHz is the
	 * default for CAM2 modules; a module with a different INCK needs its own
	 * overlay carrying that frequency. 
	*/
	cam2_xclk: cam2-xclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "cam2_xclk"
	};
};

/* CAM2: CSIPHY2, CCI1 master 0, module-local 24 MHz clock, reset GPIO77.
 * The sensor module bin for slot 8 must match the installed module, including
 * its 24 MHz INCK. */
&cam_cci1 {
	qcom,cam-sensor8 {
		compatible = "qcom,cam-sensor";
		cell-index = <8>;
		csiphy-sd-index = <2>;
		sensor-position-roll = <0>;
		sensor-position-pitch = <0>;
		sensor-position-yaw = <180>;
		cam_vio-supply = <&vreg_l18b_1p8>;
		regulator-names = "cam_vio";
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		rgltr-cntrl-support;
		pwm-switch;
		rgltr-min-voltage = <1800000>;
		rgltr-max-voltage = <1800000>;
		rgltr-load-current = <120000>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_active_rst2>;
		pinctrl-1 = <&cam_sensor_suspend_rst2>;
		gpios = <&tlmm 77 0>;
		gpio-reset = <0>;
		gpio-req-tbl-num = <0>;
		gpio-req-tbl-flags = <0>;
		gpio-req-tbl-label = "CAM_RESET2";
		sensor-mode = <0>;
		cci-master = <0>;
		clocks = <&cam2_xclk>;
		clock-names = "cam_clk";
		clock-cntl-level = "nominal";
		clock-rates = <24000000>;
		status = "ok";
	};
};
